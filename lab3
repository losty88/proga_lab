#include <stdio.h>
#include <iostream>
#include <locale.h>

using namespace std;

int main()
{
    setlocale(LC_ALL, "Russian");

    int n;
    cout << "Введите количество троек";
    cin >> n;
    if (n < 0){
        cout << "Дебил, введи положтительное число))";
        cin >> n;
    }

    int k_tr = 0;

    cout << "Введите тройки чисел (3 положительных числа через пробел): ";

    for (int i = 0; i < n; i++) {
        double a, b,c;
        cin >> a >> b >> c;
        while (a <= 0 || b <= 0 || c <= 0){
            cout << "Дебил, введи положительные числа))";
            cin >> a >> b >> c;
        }

        if ((a + b > c) && (a + c > b) && (b + c > a)){
            k_tr++;
        }
    }
    cout << k_tr;
}
