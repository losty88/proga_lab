#include <stdio.h>
#include <stdio.h>
#include <locale.h>

using namespace std;

int main()
{
    setlocale(LC_ALL, "Russian");

    int n;
    printf("Введите количество троек");
    scanf("%d", &n);
    while (n <= 0){
        printf("Дебил, введи положтительное число))");
        scanf("%d", &n);
    }

    int k_tr = 0;

    printf("Введите тройки чисел (3 положительных числа через пробел): ");

    for (int i = 0; i < n; i++) {
        double a, b,c;
        scanf("%lf %lf %lf", &a, &b, &c);
        while (a <= 0 || b <= 0 || c <= 0){
            printf("Дебил, введи положительные числа))");
            scanf("%lf %lf %lf", &a, &b, &c);
        }

        if ((a + b > c) && (a + c > b) && (b + c > a)){
            k_tr++;
        }
    }
    printf("Количество троек, которые являются треугольниакми: %d", k_tr);
}
