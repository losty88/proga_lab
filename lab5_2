#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main()
{
    const int NMax = 10000;
    int N;
    printf("Введите количетво элементов массива (от 1 до %d): \n", NMax);
    scanf("%d", &N);
    while (N < 1 || N > NMax) {
        printf("Балбес, введи число от 1 до %d: \n", NMax);
        scanf("%d", &N);
    }
    double a[NMax];
    double b[NMax];

    srand(time(0));

    for (int i = 0; i < N; i++)
    {
        a[i] = 3 + (double)rand() / RAND_MAX * 20;
    }

    printf("Исходный массив:\n");
    for (int i = 0; i < N; i++)
    {
        printf("%.2f ", a[i]);
    }
    printf("\n\n");

    int k = 0;
    for (int i = 0; i < N; i++)
    {
        int c = (int)a[i];
        if (c % 3 == 0)
        {
            b[k] = a[i];
            k++;
        }
    }

    for (int i = 0; i < k - 1; i++)
    {
        for (int j = 0; j < k - 1 - i; j++)
        {
            if (b[j] > b[j + 1])
            {
                double t = b[j];
                b[j] = b[j + 1];
                b[j + 1] = t;
            }
        }
    }
    printf("Элементы, целая часть которых кратна 3 (по возрастанию):\n");

    for (int i = 0; i < k; i++)
    {
        printf("%.2f ", b[i]);
    }
    printf("\n");
    return 0;
}
